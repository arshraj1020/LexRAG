# =============================================================
# LexRAG — AI Legal Research Intelligence Platform
# Environment Configuration Template
# Copy to .env and fill in your values.
# NEVER commit the real .env to Git.
# =============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=lexrag
POSTGRES_USER=lexrag
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# ── Spring Boot Backend ───────────────────────────────────────
BACKEND_PORT=8080
DATABASE_URL=jdbc:postgresql://postgres:5432/lexrag
DATABASE_USERNAME=lexrag
DATABASE_PASSWORD=changeme_strong_password

JWT_SECRET=changeme_jwt_secret_must_be_at_least_64_chars_long_for_hs512_algorithm
JWT_EXPIRATION_MS=86400000

# ── FastAPI AI Service ────────────────────────────────────────
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://ai-service:8001

# Internal shared secret between backend and AI service
INTERNAL_API_KEY=changeme_internal_api_key_32chars_min

# ── Ollama ────────────────────────────────────────────────────
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
# Recommended for Apple M2: mistral or llama3.2:3b (fast, accurate)
LLM_MODEL=mistral
LLM_PROVIDER=ollama

# ── Embeddings ────────────────────────────────────────────────
# Free local model — no API key needed
# Options: all-MiniLM-L6-v2 (fast, 384-dim) | BAAI/bge-base-en-v1.5 (better, 768-dim)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Reranker ─────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Retrieval Config ─────────────────────────────────────────
TOP_K=20
RERANK_TOP_K=8
HYBRID_DENSE_WEIGHT=0.6
HYBRID_SPARSE_WEIGHT=0.4

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CHUNK_SIZE=1024

# ── File Upload ───────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=/app/uploads

# ── Security ─────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── Prometheus / Grafana ─────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=changeme_grafana

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_PORT=3000

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
